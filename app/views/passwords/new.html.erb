<% content_for :title, "Reset your password" %>
<h1 class="auth-title">Reset your password</h1>
<p class="auth-lede">Enter your email and we will send a link to choose a new one.</p>

<%= form_with url: passwords_path, class: "mt-8 space-y-5" do |f| %>
  <%= f.field :email_address, as: :email, label: "Email", autofocus: true, autocomplete: "email", required: true %>
  <%= f.submit "Send reset link", class: "w-full" %>
<% end %>

<p class="auth-foot"><%= link_to "Back to sign in", login_path, class: "link" %></p>
