<% content_for :title, "Choose a new password" %>
<h1 class="auth-title">Choose a new password</h1>
<p class="auth-lede">For <strong class="text-zinc-800"><%= @user.email_address %></strong>. Every other session will be signed out.</p>

<%= form_with model: @user, url: password_path(params[:token]), method: :patch, class: "mt-8 space-y-5" do |f| %>
  <%= f.field :password, as: :password, label: "New password", hint: "At least #{User::PASSWORD_MIN_LENGTH} characters.", autofocus: true, autocomplete: "new-password", required: true %>
  <%= f.field :password_confirmation, as: :password, label: "Confirm password", autocomplete: "new-password", required: true %>
  <%= f.submit "Update password", class: "w-full" %>
<% end %>
