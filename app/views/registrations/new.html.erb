<% content_for :title, "Create your account" %>
<h1 class="auth-title">Create your account</h1>

<%= form_with model: @user, url: signup_path, class: "mt-8 space-y-5" do |f| %>
  <%= f.field :email_address, as: :email, label: "Email", autofocus: true, autocomplete: "email", required: true %>
  <div class="space-y-2" data-controller="password-rules">
    <%= f.field :password, as: :password, label: "Password", autocomplete: "new-password", required: true,
                data: { password_rules_target: "input", action: "input->password-rules#check" } %>
    <%= render "users/password_rules" %>
  </div>
  <%= f.field :password_confirmation, as: :password, label: "Confirm password", autocomplete: "new-password", required: true %>
  <%= f.submit "Create account", class: "w-full" %>
<% end %>

<p class="auth-foot">Already have an account? <%= link_to "Sign in", login_path, class: "link" %></p>
