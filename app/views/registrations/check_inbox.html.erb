<% content_for :title, "Check your inbox" %>
<h1 class="auth-title">Check your inbox</h1>
<% if @email_address.present? %>
  <p class="auth-lede">We sent an email to <strong class="text-zinc-800"><%= @email_address %></strong>. Open the link in it to finish setting up your account. The link works for 24 hours.</p>
<% else %>
  <p class="auth-lede">Open the link in the message we sent you to finish setting up your account. The link works for 24 hours.</p>
<% end %>
<div class="mt-8 flex flex-col gap-3">
  <%= button_to "Send a new link", email_verifications_path, class: "btn btn-secondary w-full", form_class: "contents" %>
</div>
<p class="auth-foot">Didn't get the email? Check your spam folder or send a new link. Already verified? <%= link_to "Sign in", login_path, class: "link" %>.</p>
