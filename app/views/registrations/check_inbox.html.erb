<% content_for :title, "Check your inbox" %>
<h1 class="auth-title">Check your inbox</h1>
<% if @email_address.present? %>
  <p class="auth-lede">We sent a message to <strong class="text-zinc-800"><%= @email_address %></strong>. Open the link in it to finish setting up your account. The link works for 24 hours.</p>
<% else %>
  <p class="auth-lede">Open the link in the message we sent you to finish setting up your account. The link works for 24 hours.</p>
<% end %>
<p class="auth-foot">Didn't get it? <%= link_to "Sign in", login_path, class: "link" %> and you can send it again.</p>
