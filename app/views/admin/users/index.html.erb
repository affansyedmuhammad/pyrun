<% content_for :title, "Users" %>
<div class="page">
  <%= render "layouts/flash" %>
  <h1 class="page-title">Users</h1>

  <%= form_with url: admin_users_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |f| %>
    <div class="field w-80">
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.text_field :email, value: @email, placeholder: "email contains…", class: "field-input" %>
    </div>
    <%= hidden_field_tag :status, @status if @status %>
    <%= f.submit "Filter", variant: :secondary %>
  <% end %>

  <nav class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Filter by status">
    <%= link_to "All", admin_users_path(email: @email), class: filter_class(@status.nil?) %>
    <% User::ACCOUNT_STATUSES.each do |candidate| %>
      <%= link_to candidate.capitalize, admin_users_path(status: candidate, email: @email), class: filter_class(@status == candidate) %>
    <% end %>
  </nav>

  <div class="mt-4 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Status</th>
          <th class="text-right">Runs</th>
          <th class="text-right">Last sign-in</th>
          <th class="text-right">Joined</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <%= render "admin/users/user", user: user, runs: @run_counts.fetch(user.id, 0), sessions: @session_counts.fetch(user.id, 0) %>
        <% end %>
        <% if @users.empty? %>
          <tr><td colspan="6" class="py-10 text-center text-zinc-500">Nothing matches this filter.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "runs/pagination", pagy: @pagy, path: ->(page) { admin_users_path(status: @status, email: @email, page: page) } %>
</div>
