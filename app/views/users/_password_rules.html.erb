<%# The checklist under a new-password field. Rules come from the model so this
    list and the validation cannot disagree; the Stimulus controller only reads them. %>
<ul class="rules" aria-label="Password requirements">
  <li data-password-rules-target="rule" data-min-length="<%= User::PASSWORD_MIN_LENGTH %>" data-met="false">
    <%= t("password_rules.length", count: User::PASSWORD_MIN_LENGTH) %>
  </li>
  <% User::PASSWORD_RULES.each do |name, pattern| %>
    <li data-password-rules-target="rule" data-pattern="<%= pattern.source %>" data-met="false"><%= t("password_rules.#{name}") %></li>
  <% end %>
</ul>
