<% content_for :title, @message.subject %>
<div class="page max-w-3xl">
  <p class="text-sm"><%= link_to "Back to inbox", dev_mail_path, class: "link" %></p>
  <h1 class="page-title mt-4"><%= @message.subject %></h1>

  <dl class="meta">
    <div class="col-span-2"><dt>To</dt><dd class="break-all"><%= @message.to.join(", ") %></dd></div>
    <div><dt>From</dt><dd class="break-all"><%= @message.from.join(", ") %></dd></div>
    <div><dt>Sent</dt><dd><%= relative_time(@message.delivered_at) %></dd></div>
  </dl>

  <section class="mt-8">
    <h2 class="section-title">Message</h2>
    <pre class="output"><%= linkify(@message.text) %></pre>
  </section>
</div>
