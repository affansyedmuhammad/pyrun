<nav class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Filter by status">
  <%= link_to "All", path.call(nil), class: filter_class(status.nil?) %>
  <% Run::STATUSES.each do |candidate| %>
    <%= link_to RunsHelper::STATUS_LABELS[candidate], path.call(candidate), class: filter_class(status == candidate) %>
  <% end %>
</nav>
