<%# Rows from the all-runs list carry from=all so the run page comes back here. %>
<% from = show_owner ? "all" : nil %>
<div class="mt-4 overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th>Status</th>
        <% if show_owner %><th>Owner</th><% end %>
        <th>Code</th>
        <th class="text-right">Duration</th>
        <th class="text-right">Submitted</th>
      </tr>
    </thead>
    <tbody>
      <% runs.each do |run| %>
        <tr>
          <td><span class="status"><%= status_dot(run) %><%= status_label(run) %></span></td>
          <% if show_owner %><td class="whitespace-nowrap text-zinc-500"><%= run.user.email_address %></td><% end %>
          <td class="w-full min-w-48 max-w-0"><%= link_to run.first_line, run_path(run, from: from), class: "block truncate font-mono text-[13px] text-zinc-900" %></td>
          <td class="whitespace-nowrap text-right tabular-nums text-zinc-500"><%= format_duration(run.duration_ms) %></td>
          <td class="whitespace-nowrap text-right text-zinc-500"><%= relative_time(run.created_at) %></td>
        </tr>
      <% end %>
      <% if runs.empty? %>
        <tr><td colspan="5" class="py-10 text-center text-zinc-500">Nothing matches this filter.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
