<%# Signed-out pages: just the wordmark (and the development inbox). %>
<header class="border-b border-zinc-200 bg-white">
  <div class="flex h-14 items-center gap-4 px-6">
    <%= link_to root_path, class: "wordmark" do %><%= logo_mark %><span><%= Pyrun.config.app_name %></span><% end %>
    <% if Rails.env.development? %>
      <%= link_to "Mail", dev_mail_path, class: "text-sm text-zinc-500 hover:text-zinc-900", title: "Development inbox" %>
    <% end %>
  </div>
</header>
